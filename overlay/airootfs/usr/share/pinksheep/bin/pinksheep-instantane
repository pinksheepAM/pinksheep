#!/usr/bin/env bash
# ╭──────────────────────────────────────────────────────────────╮
# │  PinkSheep — instantané du système (Timeshift)                │
# │                                                              │
# │  Pris tout seul avant chaque mise à jour (crochet pacman),    │
# │  au plus un par heure. Permet de revenir en arrière si une    │
# │  mise à jour casse quelque chose :                            │
# │      sudo timeshift --restore     (ou l'appli Timeshift)      │
# │                                                              │
# │  sudo pinksheep-instantane          en prendre un maintenant  │
# │  sudo pinksheep-instantane --liste  voir ceux de PinkSheep    │
# │  sudo pinksheep-instantane --configurer  (re)régler Timeshift │
# │                                                              │
# │  Tes fichiers personnels (/home) ne sont pas dedans : seul le │
# │  système l'est. Ne bloque JAMAIS une mise à jour.             │
# ╰──────────────────────────────────────────────────────────────╯
set -uo pipefail
CONF=/etc/timeshift/timeshift.json
REPERE=/var/lib/pinksheep/dernier-instantane
JOURNAL=/var/log/pinksheep-instantane.log
GARDER=3                # instantanés automatiques gardés (les plus anciens sont supprimés)
MIN_INTERVALLE=3600     # pas plus d'un instantané automatique par heure
MIN_LIBRE_GO=15         # place libre minimum sur le disque du système

MODE=manuel
case "${1:-}" in
    avant-pacman) MODE=auto ;;
    --liste) MODE=liste ;;
    --configurer) MODE=configurer ;;
    "") ;;
    -h|--help) sed -n '2,17p' "$0"; exit 0 ;;
    *) echo "Option inconnue : $1"; exit 0 ;;
esac

[[ $EUID -eq 0 ]] || { echo "À lancer avec sudo : sudo pinksheep-instantane $*"; exit 0; }
command -v timeshift >/dev/null || { [[ $MODE == auto ]] || echo "Timeshift n'est pas installé."; exit 0; }
# Pendant l'installation (chroot), rien
[[ -d /run/systemd/system ]] || exit 0

# Réglage de Timeshift adapté au disque : btrfs (instantanés instantanés) si le
# système est en btrfs avec les sous-volumes @ / @home, sinon rsync.
configurer() {
    local type uuid source btrfs=false
    type="$(findmnt -no FSTYPE /)"
    source="$(findmnt -no SOURCE /)"
    uuid="$(findmnt -no UUID /)"
    [[ -n "$uuid" ]] || { echo "Disque du système introuvable : Timeshift non réglé."; return 1; }
    if [[ $type == btrfs && $source == *"[/@]" ]]; then btrfs=true; fi
    mkdir -p "$(dirname "$CONF")"
    cat > "$CONF" <<EOF
{
  "backup_device_uuid" : "$uuid",
  "parent_device_uuid" : "",
  "do_first_run" : "false",
  "btrfs_mode" : "$btrfs",
  "include_btrfs_home_for_backup" : "false",
  "include_btrfs_home_for_restore" : "false",
  "stop_cron_emails" : "true",
  "schedule_monthly" : "false",
  "schedule_weekly" : "false",
  "schedule_daily" : "false",
  "schedule_hourly" : "false",
  "schedule_boot" : "false",
  "count_monthly" : "2",
  "count_weekly" : "3",
  "count_daily" : "5",
  "count_hourly" : "6",
  "count_boot" : "5",
  "date_format" : "%Y-%m-%d %H:%M:%S",
  "exclude" : [
    "/home/**",
    "/root/**",
    "/var/cache/pacman/pkg/**",
    "/var/lib/flatpak/**",
    "/var/tmp/**"
  ],
  "exclude-apps" : []
}
EOF
    if [[ $btrfs == true ]]; then echo "Timeshift réglé (mode btrfs)."; else echo "Timeshift réglé (mode rsync, sur le disque du système)."; fi
}

# Noms des instantanés pris par PinkSheep, du plus ancien au plus récent
instantanes_pinksheep() {
    timeshift --list 2>/dev/null | awk '/PinkSheep : avant mise à jour|PinkSheep : à la main/ {for (i=1;i<=NF;i++) if ($i ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}$/) print $i}'
}

case $MODE in
    configurer) configurer; exit 0 ;;
    liste) instantanes_pinksheep; exit 0 ;;
esac

[[ -f "$CONF" ]] || configurer >/dev/null || exit 0

if [[ $MODE == auto && -f "$REPERE" ]]; then
    if (( $(date +%s) - $(stat -c %Y "$REPERE") < MIN_INTERVALLE )); then
        echo "   (instantané de moins d'une heure : on le garde)"; exit 0
    fi
fi

if ! grep -q '"btrfs_mode" : "true"' "$CONF"; then
    libre=$(( $(df --output=avail -k / | tail -n1) / 1024 / 1024 ))
    if (( libre < MIN_LIBRE_GO )); then
        echo "   [!] Moins de ${MIN_LIBRE_GO} Go libres : pas d'instantané cette fois (la mise à jour continue)."
        exit 0
    fi
fi

if [[ $MODE == auto ]]; then
    echo "   Instantané du système avant la mise à jour (la toute première fois : quelques minutes)…"
    commentaire="PinkSheep : avant mise à jour $(date '+%d/%m %H:%M')"
else
    commentaire="PinkSheep : à la main $(date '+%d/%m %H:%M')"
fi

mkdir -p "$(dirname "$REPERE")"
if nice -n 10 ionice -c3 timeshift --create --scripted --tags O --comments "$commentaire" >"$JOURNAL" 2>&1; then
    touch "$REPERE"
    echo "   Instantané pris. Revenir en arrière : sudo timeshift --restore"
else
    echo "   [!] L'instantané a échoué (détails : $JOURNAL). La mise à jour continue."
    exit 0
fi

# Ménage : on garde les $GARDER plus récents
mapfile -t liste < <(instantanes_pinksheep)
a_supprimer=$(( ${#liste[@]} - GARDER ))
for ((i = 0; i < a_supprimer; i++)); do
    timeshift --delete --snapshot "${liste[$i]}" --scripted >>"$JOURNAL" 2>&1 || true
done
exit 0
