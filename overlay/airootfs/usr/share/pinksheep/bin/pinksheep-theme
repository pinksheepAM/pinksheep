#!/usr/bin/env bash
# PinkSheep — applique le thème sombre aux applis GTK/GNOME à chaque connexion.
if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
    if [[ -d /usr/share/themes/adw-gtk3-dark ]]; then
        gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark'   # suit les couleurs auto
    else
        gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'
    fi
    gsettings set org.gnome.desktop.interface icon-theme   'Papirus-Dark'
    gsettings set org.gnome.desktop.interface cursor-theme 'breeze_cursors'
    gsettings set org.gnome.desktop.interface cursor-size  24
    gsettings set org.gnome.desktop.interface font-name    'Noto Sans 11'
fi
hyprctl setcursor breeze_cursors 24 >/dev/null 2>&1 || true

# Reconstruit la liste des applis pour le menu « Ouvrir avec » de Dolphin
if command -v kbuildsycoca6 >/dev/null 2>&1; then
    kbuildsycoca6 --noincremental >/dev/null 2>&1 &
fi

# Comptes créés après l'installation : complète les chemins personnels une fois
if grep -q '@HOME@' "$HOME/.config/qt6ct/qt6ct.conf" 2>/dev/null; then
    sed -i "s#@HOME@#$HOME#g" "$HOME/.config/qt6ct/qt6ct.conf"
fi
if grep -q '@MUSIQUE@' "$HOME/.config/mpd/mpd.conf" 2>/dev/null; then
    musique="$(xdg-user-dir MUSIC 2>/dev/null || echo "$HOME/Musique")"
    sed -i "s#@MUSIQUE@#$musique#g" "$HOME/.config/mpd/mpd.conf"
    mkdir -p "$musique" "$HOME/.local/share/mpd/playlists" "$HOME/.local/state/mpd"
fi
