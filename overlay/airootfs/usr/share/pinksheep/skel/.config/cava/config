# Visualiseur audio cava — généré par matugen (couleurs du fond d'écran)
[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1

[input]
method = pipewire
source = auto

[output]
method = noncurses

[color]
gradient = 1
gradient_count = 4
gradient_color_1 = '#f8b3d0'
gradient_color_2 = '#e6bad7'
gradient_color_3 = '#f9acff'
gradient_color_4 = '#ffd6fe'

[smoothing]
noise_reduction = 77
