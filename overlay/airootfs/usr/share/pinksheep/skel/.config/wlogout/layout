{
    "label" : "lock",
    "action" : "loginctl lock-session",
    "text" : "Verrouiller",
    "keybind" : "v"
}
{
    "label" : "logout",
    "action" : "hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'",
    "text" : "Déconnexion",
    "keybind" : "d"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Veille",
    "keybind" : "s"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Redémarrer",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Éteindre",
    "keybind" : "e"
}
