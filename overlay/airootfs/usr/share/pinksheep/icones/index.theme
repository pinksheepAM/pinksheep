[Icon Theme]
Name=PinkSheep
Comment=Icônes PinkSheep aux couleurs du fond d'écran (le reste vient de Papirus)
Inherits=Papirus-Dark,breeze-dark,hicolor
Example=folder
Directories=scalable/places,scalable/apps

[scalable/places]
Size=64
MinSize=16
MaxSize=512
Context=Places
Type=Scalable

[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Context=Applications
Type=Scalable
