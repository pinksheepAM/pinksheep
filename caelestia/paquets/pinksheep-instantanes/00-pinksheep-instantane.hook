# PinkSheep — instantané du système AVANT toute installation, mise à jour ou suppression.
# Le préfixe 00 le fait passer avant les autres crochets.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = [PinkSheep] Instantané du système avant la mise à jour…
When = PreTransaction
Exec = /usr/bin/pinksheep-instantane avant-pacman
