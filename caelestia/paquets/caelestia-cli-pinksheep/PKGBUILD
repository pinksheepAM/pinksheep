# PinkSheep — CLI Caelestia, version figée.
# Différence avec l'AUR : /usr/bin/caelestia est un garde-fou qui bloque
# « caelestia install » et « caelestia update » (ils passent par paru et
# réécrivent ~/.config, ce qui casserait PinkSheep). Le vrai programme est
# dans /usr/lib/caelestia-cli/caelestia.
pkgname=caelestia-cli-pinksheep
pkgver=1.1.3
pkgrel=1
pkgdesc='CLI des dotfiles Caelestia (version figée pour PinkSheep)'
arch=('any')
url='https://github.com/caelestia-dots/cli'
license=('GPL-3.0-only')
depends=('python>=3.13' 'python-pillow' 'python-materialyoucolor' 'libnotify' 'swappy' 'grim'
         'dart-sass' 'wl-clipboard' 'slurp' 'gpu-screen-recorder' 'dconf' 'cliphist' 'fuzzel' 'git')
makedepends=('python-build' 'python-installer' 'python-hatch' 'python-hatch-vcs')
provides=("caelestia-cli=${pkgver}")
conflicts=('caelestia-cli' 'caelestia-cli-git')
_archive="caelestia-${pkgver}"
source=("${url}/releases/download/v${pkgver}/${_archive}.tar.gz"
        'caelestia-garde')
sha256sums=('f31447efdd94a18556e338bcf8a38236f34660a56b241657817e6cbe80b067e3'
            'SKIP')

build() {
    cd "$_archive"
    # hatch-vcs lit la version dans git : on la donne directement
    SETUPTOOLS_SCM_PRETEND_VERSION="$pkgver" python -m build --wheel --no-isolation
}

package() {
    cd "$_archive"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 completions/caelestia.fish "$pkgdir/usr/share/fish/vendor_completions.d/caelestia.fish"
    # Le vrai programme passe dans /usr/lib, le garde-fou prend sa place
    install -dm755 "$pkgdir/usr/lib/caelestia-cli"
    mv "$pkgdir/usr/bin/caelestia" "$pkgdir/usr/lib/caelestia-cli/caelestia"
    install -Dm755 "$srcdir/caelestia-garde" "$pkgdir/usr/bin/caelestia"
}
